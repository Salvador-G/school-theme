---
import type { SiteConfig } from "../../lib/publish-guard";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
---

<section
  id="niveles"
  class="mx-auto max-w-7xl px-4 py-(--space-section) sm:px-6 lg:px-8"
>
  <div class="mb-12 text-center">
    <span
      class="inline-block bg-brand-accent/30 px-3 py-1 text-xs font-bold tracking-widest text-brand-primary uppercase shape-leaf-right"
    >
      {site.serviciosTexto.etiqueta}
    </span>
    <h2 class="mt-3 text-3xl font-extrabold text-brand-primary sm:text-4xl">
      {site.serviciosTexto.titulo}
    </h2>
    <p class="mx-auto mt-2 max-w-2xl text-sm text-slate-600 sm:text-base">
      {site.serviciosTexto.subtitulo}
    </p>
  </div>

  <div class="grid gap-8 md:grid-cols-3">
    {
      site.servicios.map((nivel, idx) => (
        <article
          class={`flex flex-col justify-between border border-slate-200 bg-white p-8 shadow-sm transition hover:shadow-md ${idx % 2 === 0 ? "shape-leaf-right" : "shape-leaf-left"}`}
        >
          <div>
            <span class="inline-block bg-brand-primary/10 px-3 py-1 text-xs font-bold text-brand-primary shape-leaf-left">
              {nivel.edades}
            </span>
            <h3 class="mt-4 text-2xl font-bold text-brand-primary">
              {nivel.nombre}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">
              {nivel.descripcion}
            </p>
          </div>
          <a
            href={nivel.href || "/admision"}
            class="mt-6 inline-flex items-center gap-1 text-sm font-bold text-brand-primary hover:text-brand-light"
          >
            Consultar vacantes →
          </a>
        </article>
      ))
    }
  </div>
</section>
