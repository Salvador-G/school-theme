---
import type { SiteConfig } from "../../lib/publish-guard";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
---

<section
  id="inicio"
  class="mx-auto max-w-7xl px-4 pt-6 pb-(--space-section) sm:px-6 lg:px-8"
>
  <div
    class="relative flex min-h-[500px] items-center justify-center overflow-hidden bg-brand-primary px-6 py-16 text-center text-white shadow-xl shape-leaf-right sm:px-12"
  >
    <div
      id="slide-bg"
      class="absolute inset-0 bg-cover bg-center opacity-25 mix-blend-overlay transition-opacity duration-500 ease-in-out"
      style={`background-image: url('${site.slides[0].bgImage}')`}
    >
    </div>

    <div class="relative z-10 mx-auto max-w-3xl space-y-6">
      <span
        class="inline-block bg-brand-accent px-4 py-1.5 text-xs font-bold tracking-wider text-brand-primary uppercase shape-leaf-left"
      >
        Matrículas Abiertas {site.anioAdmision}
      </span>
      <h1
        id="slide-title"
        class="text-4xl leading-tight font-extrabold transition-opacity duration-500 sm:text-5xl lg:text-6xl"
      >
        {site.slides[0].titulo}
      </h1>
      <p
        id="slide-sub"
        class="mx-auto max-w-2xl text-lg text-slate-200 transition-opacity duration-500 sm:text-xl"
      >
        {site.slides[0].subtitulo}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a
          href="/admision"
          class="bg-brand-accent px-8 py-4 font-bold text-brand-primary transition hover:brightness-110 shape-leaf-right"
        >
          Solicitar Vacante →
        </a>
        <a
          href="#cachimbos"
          class="border border-white/40 px-7 py-4 text-white backdrop-blur-sm transition hover:bg-white/10 shape-leaf-left"
        >
          Ver Ingresantes
        </a>
      </div>
    </div>
  </div>
</section>
