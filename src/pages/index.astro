---
import Layout from "../layouts/Layout.astro";
import { SCHOOL_DATA, ADMISSION_YEAR } from "../data/school.config";
---

<Layout title="Inicio">
  <!-- 1. HERO CON SLIDER Y ESTUDIANTE PNG SOBRESALIENTE -->
  <section id="inicio" class="pt-6 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="relative bg-brand-primary text-white shape-leaf-right overflow-hidden shadow-xl min-h-[480px] flex items-center">
      
      <!-- Novedad: Contenedor absoluto para la imagen de fondo con opacidad baja -->
      <div 
        id="slide-bg"
        class="absolute inset-0 bg-cover bg-center opacity-30 transition-opacity duration-500 ease-in-out mix-blend-overlay"
        style={`background-image: url('${SCHOOL_DATA.slides[0].bgImage}')`}
      ></div>

      <!-- Decoración geométrica de fondo -->
      <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-brand-accent/30 rounded-full blur-2xl pointer-events-none"></div>

      <div class="grid md:grid-cols-12 items-center w-full p-8 md:p-14 gap-8 relative z-10">
        <!-- Texto del Slide -->
        <div class="md:col-span-7 space-y-6">
          <span class="inline-block bg-brand-accent text-brand-primary font-bold text-xs uppercase px-3 py-1 shape-leaf-left">
            Matrículas Abiertas {ADMISSION_YEAR}
          </span>
          <h1 id="slide-title" class="text-4xl sm:text-5xl font-extrabold leading-tight transition-opacity duration-500">
            {SCHOOL_DATA.slides[0].titulo}
          </h1>
          <p id="slide-sub" class="text-lg text-slate-200 max-w-xl transition-opacity duration-500">
            {SCHOOL_DATA.slides[0].subtitulo}
          </p>
          <div class="flex flex-wrap gap-4 pt-2">
            <a href="/admision" class="bg-brand-accent text-brand-primary font-bold px-7 py-3.5 shape-leaf-right hover:brightness-110 transition">
              Solicitar Vacante →
            </a>
            <a href="#cachimbos" class="border border-white/40 text-white px-6 py-3.5 shape-leaf-left hover:bg-white/10 transition backdrop-blur-sm">
              Ver Ingresantes
            </a>
          </div>
        </div>

        <!-- Espacio para PNG de Estudiante -->
        <div class="md:col-span-5 relative flex justify-center items-end">
          <div class="w-64 h-72 bg-brand-accent shape-arch relative flex items-end justify-center shadow-inner">
            <img 
              id="slide-img"
              src={SCHOOL_DATA.slides[0].studentPng} 
              alt="Estudiante" 
              class="w-60 h-80 object-contain -mt-12 drop-shadow-2xl transition-opacity duration-500"
              onerror="this.style.display='none'"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. SECCIÓN NOSOTROS (CAJA ASIMÉTRICA INVERTIDA + PNG) -->
  <section id="nosotros" class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      
      <!-- Bloque visual con esquinas opuestas -->
      <div class="lg:col-span-5 relative">
        <div class="bg-brand-primary/5 border-2 border-brand-primary/20 p-8 shape-leaf-left relative">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-primary">Nuestra Propuesta</span>
          <h2 class="text-3xl font-extrabold text-brand-primary mt-2">Educación que transforma el futuro</h2>
          <p class="mt-4 text-slate-600 leading-relaxed">{SCHOOL_DATA.nosotros.historia}</p>
          
          <ul class="mt-6 space-y-3">
            {SCHOOL_DATA.nosotros.pilares.map((pilar) => (
              <li class="flex items-center gap-3 font-medium text-slate-800">
                <span class="w-6 h-6 bg-brand-accent text-brand-primary font-bold flex items-center justify-center shape-leaf-right text-xs">✓</span>
                {pilar}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Métricas en tarjetas no rectangulares -->
      <div class="lg:col-span-7 grid sm:grid-cols-3 gap-6">
        {SCHOOL_DATA.nosotros.stats.map((stat, idx) => (
          <div class={`p-6 border border-slate-200 bg-white shadow-sm ${idx % 2 === 0 ? 'shape-leaf-right' : 'shape-leaf-left'}`}>
            <p class="text-4xl font-extrabold text-brand-primary">{stat.numero}</p>
            <p class="mt-2 text-sm text-slate-600 font-medium">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. CASOS DE ÉXITO (CACHIMBOS / INGRESANTES) -->
  <section id="cachimbos" class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-brand-primary bg-brand-accent/30 px-3 py-1 shape-leaf-right">
          Orgullo Institucional
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-primary mt-3">
          Nuestros Ingresantes a Universidades
        </h2>
      </div>
      <p class="text-slate-600 max-w-md mt-2 md:mt-0 text-sm">
        Preparación de alto nivel que garantiza el ingreso directo de nuestros alumnos de 5to de secundaria.
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {SCHOOL_DATA.cachimbos.map((alumno) => (
        <article class="bg-white border border-slate-200 shape-leaf-right p-6 shadow-sm hover:shadow-md transition relative overflow-hidden group">
          <!-- Insignia Universidad -->
          <span class="absolute top-4 right-4 bg-brand-primary text-brand-accent font-bold text-xs px-3 py-1 shape-leaf-left">
            {alumno.universidad}
          </span>

          <!-- Contenedor para PNG de estudiante o foto -->
          <div class="w-28 h-28 bg-brand-surface border-2 border-brand-accent shape-arch mb-5 overflow-hidden flex items-end justify-center">
            <img src={alumno.foto} alt={alumno.nombre} class="w-24 h-28 object-cover" onerror="this.style.display='none'" />
          </div>

          <p class="text-xs font-bold uppercase text-emerald-700">{alumno.puesto}</p>
          <h3 class="text-xl font-bold text-brand-primary mt-1">{alumno.nombre}</h3>
          <p class="text-sm text-slate-600 mt-1">Carrera: <strong class="text-slate-900">{alumno.carrera}</strong></p>
          <p class="text-xs text-slate-400 mt-3">Promoción {alumno.promocion}</p>
        </article>
      ))}
    </div>
  </section>

  <script define:vars={{ slides: SCHOOL_DATA.slides }}>
    const bg = document.getElementById('slide-bg');
    const title = document.getElementById('slide-title');
    const sub = document.getElementById('slide-sub');
    const img = document.getElementById('slide-img');
    
    // Solo inicia el carrusel si hay más de 1 slide
    if (bg && title && sub && img && slides.length > 1) {
      let currentIndex = 0;
      
      setInterval(() => {
        // 1. Desvanecer elementos (Fade out)
        title.style.opacity = '0';
        sub.style.opacity = '0';
        img.style.opacity = '0';
        bg.style.opacity = '0';

        // 2. Esperar medio segundo para cambiar textos/imágenes y volver a mostrarlos
        setTimeout(() => {
          currentIndex = (currentIndex + 1) % slides.length;
          const nextSlide = slides[currentIndex];
          
          title.textContent = nextSlide.titulo;
          sub.textContent = nextSlide.subtitulo;
          img.src = nextSlide.studentPng;
          bg.style.backgroundImage = `url('${nextSlide.bgImage}')`;
          
          // 3. Aparecer elementos (Fade in)
          title.style.opacity = '1';
          sub.style.opacity = '1';
          img.style.opacity = '1';
          bg.style.opacity = '0.3'; // Mantiene la opacidad original para que el texto se lea
        }, 500); 
      }, 5000); // Cambia cada 5 segundos
    }
  </script>
</Layout>