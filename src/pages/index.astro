---
import Layout from "../layouts/Layout.astro";
import siteData from "../data/site.json";
import { verifyPublishReadiness, type SiteConfig } from "../lib/publish-guard";
import type { HeroVariant, ServiciosVariant } from "../lib/presets";

import HeroDividido from "../components/hero/HeroDividido.astro";
import HeroCentrado from "../components/hero/HeroCentrado.astro";
import ServiciosRejilla from "../components/servicios/ServiciosRejilla.astro";
import ServiciosLista from "../components/servicios/ServiciosLista.astro";

const site: SiteConfig = siteData;
const esDemo = import.meta.env.PUBLIC_DEMO === "true";

verifyPublishReadiness(site, esDemo, import.meta.env.PROD);

const heroVariant = (site.diseno.variantes?.hero || "dividido") as HeroVariant;
const serviciosVariant = (site.diseno.variantes?.servicios ||
  "rejilla") as ServiciosVariant;

const HeroComponent = heroVariant === "centrado" ? HeroCentrado : HeroDividido;
const ServiciosComponent =
  serviciosVariant === "lista" ? ServiciosLista : ServiciosRejilla;
---

<Layout title="Inicio">
  {
    site.diseno.orden.map((seccion) => {
      switch (seccion) {
        case "hero":
          return <HeroComponent site={site} />;

        case "nosotros":
          return (
            <section
              id="nosotros"
              class="mx-auto max-w-7xl px-4 py-(--space-section) sm:px-6 lg:px-8"
            >
              <div class="grid items-center gap-12 lg:grid-cols-12">
                <div class="relative lg:col-span-5">
                  <div class="relative border-2 border-brand-primary/20 bg-brand-primary/5 p-8 shape-leaf-left">
                    <span class="text-xs font-bold tracking-widest text-brand-primary uppercase">
                      {site.nosotros.etiqueta}
                    </span>
                    <h2 class="mt-2 text-3xl font-extrabold text-brand-primary">
                      {site.nosotros.titulo}
                    </h2>
                    <p class="mt-4 leading-relaxed text-slate-600">
                      {site.nosotros.historia}
                    </p>

                    <ul class="mt-6 space-y-3">
                      {site.nosotros.pilares.map((pilar) => (
                        <li class="flex items-center gap-3 font-medium text-slate-800">
                          <span class="flex h-6 w-6 shrink-0 items-center justify-center bg-brand-accent text-xs font-bold text-brand-primary shape-leaf-right">
                            ✓
                          </span>
                          {pilar}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="grid gap-6 sm:grid-cols-3 lg:col-span-7">
                  {site.nosotros.stats.map((stat, idx) => (
                    <div
                      class={`border border-slate-200 bg-white p-6 shadow-sm ${idx % 2 === 0 ? "shape-leaf-right" : "shape-leaf-left"}`}
                    >
                      <p class="font-heading text-4xl font-extrabold text-brand-primary">
                        {stat.numero}
                      </p>
                      <p class="mt-2 text-sm font-medium text-slate-600">
                        {stat.label}
                      </p>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );

        case "servicios":
          return <ServiciosComponent site={site} />;

        case "cachimbos":
          return (
            <section
              id="cachimbos"
              class="mx-auto max-w-7xl px-4 py-(--space-section) sm:px-6 lg:px-8"
            >
              <div class="mb-12 flex flex-col justify-between md:flex-row md:items-end">
                <div>
                  <span class="bg-brand-accent/30 px-3 py-1 text-xs font-bold tracking-widest text-brand-primary uppercase shape-leaf-right">
                    Orgullo Institucional
                  </span>
                  <h2 class="mt-3 text-3xl font-extrabold text-brand-primary sm:text-4xl">
                    Nuestros Ingresantes a Universidades
                  </h2>
                </div>
                <p class="mt-2 max-w-md text-sm text-slate-600 md:mt-0">
                  Preparación de alto nivel que garantiza el ingreso directo de
                  nuestros alumnos de 5.º de secundaria.
                </p>
              </div>

              <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                {site.cachimbos.map((alumno) => (
                  <article class="group relative overflow-hidden border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md shape-leaf-right">
                    <span class="absolute top-4 right-4 bg-brand-primary px-3 py-1 text-xs font-bold text-brand-accent shape-leaf-left">
                      {alumno.universidad}
                    </span>

                    <div class="mb-5 flex h-28 w-28 items-end justify-center overflow-hidden border-2 border-brand-accent bg-brand-surface shape-arch">
                      <img
                        src={alumno.foto}
                        alt={alumno.nombre}
                        class="h-28 w-24 object-cover"
                        onerror="this.style.display='none'"
                      />
                    </div>

                    <p class="text-xs font-bold text-emerald-700 uppercase">
                      {alumno.puesto}
                    </p>
                    <h3 class="mt-1 text-xl font-bold text-brand-primary">
                      {alumno.nombre}
                    </h3>
                    <p class="mt-1 text-sm text-slate-600">
                      Carrera:{" "}
                      <strong class="text-slate-900">{alumno.carrera}</strong>
                    </p>
                    <p class="mt-3 text-xs text-slate-400">
                      Promoción {alumno.promocion}
                    </p>
                  </article>
                ))}
              </div>
            </section>
          );

        default:
          return null;
      }
    })
  }

  <script define:vars={{ slides: site.slides }}>
    const bg = document.getElementById("slide-bg");
    const title = document.getElementById("slide-title");
    const sub = document.getElementById("slide-sub");
    const img = document.getElementById("slide-img");

    if (bg && title && sub && slides.length > 1) {
      let currentIndex = 0;

      setInterval(() => {
        title.style.opacity = "0";
        sub.style.opacity = "0";
        if (img) img.style.opacity = "0";
        bg.style.opacity = "0";

        setTimeout(() => {
          currentIndex = (currentIndex + 1) % slides.length;
          const nextSlide = slides[currentIndex];

          title.textContent = nextSlide.titulo;
          sub.textContent = nextSlide.subtitulo;
          if (img) img.src = nextSlide.studentPng;
          bg.style.backgroundImage = `url('${nextSlide.bgImage}')`;

          title.style.opacity = "1";
          sub.style.opacity = "1";
          if (img) img.style.opacity = "1";
          bg.style.opacity = "0.3";
        }, 500);
      }, 5000);
    }
  </script>
</Layout>
