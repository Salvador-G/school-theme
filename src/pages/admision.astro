---
import Layout from "../layouts/Layout.astro";
import { SCHOOL_DATA, ADMISSION_YEAR } from "../data/school.config";
---

<Layout title={`Admisión ${ADMISSION_YEAR}`}>
  <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-12 gap-12 items-start">
      <!-- COLUMNA IZQUIERDA: INFORMACIÓN REGLAMENTARIA Y COSTOS -->
      <div class="lg:col-span-7 space-y-8">
        <div>
          <span
            class="bg-brand-accent text-brand-primary font-bold text-xs px-3 py-1 shape-leaf-right uppercase"
          >
            Proceso de Matrícula
          </span>
          <h1 class="text-4xl font-extrabold text-brand-primary mt-3">
            Admisión Escolar {ADMISSION_YEAR}
          </h1>
          <p class="mt-3 text-slate-600 leading-relaxed">
            Forma parte de nuestra comunidad educativa. Completa el formulario
            para agendar una visita guiada o recibir atención directa por
            secretaría.
          </p>
        </div>

        <!-- TABLA DE COSTOS (MUY VALORADA POR LOS COLEGIOS POR LEY INDECOPI) -->
        <div
          class="bg-white border border-slate-200 shape-leaf-left p-6 shadow-sm"
        >
          <h2 class="text-lg font-bold text-brand-primary">
            Inversión Educativa {ADMISSION_YEAR}
          </h2>
          <p class="text-xs text-slate-500 mb-4">
            Información transparente conforme al Código de Protección al
            Consumidor.
          </p>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead
                class="border-b border-slate-200 text-xs uppercase text-slate-500"
              >
                <tr>
                  <th class="py-3">Nivel</th>
                  <th class="py-3">Cuota de Ingreso</th>
                  <th class="py-3">Matrícula</th>
                  <th class="py-3">Pensión Mensual</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {
                  SCHOOL_DATA.costosAdmision.map((item) => (
                    <tr>
                      <td class="py-3 font-semibold text-brand-primary">
                        {item.nivel}
                      </td>
                      <td class="py-3 text-slate-600">{item.cuotaIngreso}</td>
                      <td class="py-3 text-slate-600">S/ {item.matricula}</td>
                      <td class="py-3 font-bold text-slate-900">
                        S/ {item.pension}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <!-- REQUISITOS -->
        <div class="bg-brand-primary/5 p-6 shape-leaf-right">
          <h3 class="font-bold text-brand-primary">
            Documentos requeridos para el traslado:
          </h3>
          <ul class="mt-3 grid sm:grid-cols-2 gap-2 text-sm text-slate-700">
            <li>• Copia de DNI del estudiante y padres</li>
            <li>• Ficha Única de Matrícula (SIAGIE)</li>
            <li>• Certificado de estudios previos</li>
            <li>• Constancia de no adeudo del colegio de origen</li>
          </ul>
        </div>
      </div>

      <!-- COLUMNA DERECHA: FORMULARIO DE ADMISIÓN -->
      <div
        class="lg:col-span-5 bg-white border-2 border-brand-primary shape-leaf-right p-8 shadow-lg"
      >
        <h2 class="text-2xl font-extrabold text-brand-primary">
          Reserva tu Vacante
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          Te contactaremos en menos de 24 horas hábiles.
        </p>

        <form class="mt-6 space-y-4" action="#" method="POST">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-700"
              >Nombre del Padre / Apoderado *</label
            >
            <input
              type="text"
              required
              class="mt-1 w-full border border-slate-300 px-3.5 py-2.5 text-sm focus:border-brand-primary focus:outline-none"
              placeholder="Ej. Juan Pérez"
            />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase text-slate-700"
                >WhatsApp / Celular *</label
              >
              <input
                type="tel"
                required
                class="mt-1 w-full border border-slate-300 px-3.5 py-2.5 text-sm focus:border-brand-primary focus:outline-none"
                placeholder="999 888 777"
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase text-slate-700"
                >Nivel de interés *</label
              >
              <select
                class="mt-1 w-full border border-slate-300 bg-white px-3.5 py-2.5 text-sm focus:border-brand-primary focus:outline-none"
              >
                <option>Inicial</option>
                <option>Primaria</option>
                <option>Secundaria</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-slate-700"
              >Grado al que postula en {ADMISSION_YEAR}</label
            >
            <input
              type="text"
              class="mt-1 w-full border border-slate-300 px-3.5 py-2.5 text-sm focus:border-brand-primary focus:outline-none"
              placeholder="Ej. 3ro de Primaria"
            />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-slate-700"
              >Consulta adicional (Opcional)</label
            >
            <textarea
              rows="3"
              class="mt-1 w-full border border-slate-300 px-3.5 py-2.5 text-sm focus:border-brand-primary focus:outline-none"
              placeholder="Quisiera consultar sobre horarios o talleres..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-brand-primary text-brand-accent font-bold py-3.5 shape-leaf-left hover:bg-brand-light transition shadow-md"
          >
            Enviar Solicitud de Admisión
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>
