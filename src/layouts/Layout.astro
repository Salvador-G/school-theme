---
import "../styles/global.css";
import siteData from "../data/site.json";
import { getGoogleFontsUrl, type PresetName } from "../lib/presets";
import { buildSchemaData } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
}

const site = siteData;
const esDemo = import.meta.env.PUBLIC_DEMO === "true";
const preset = (site.diseno.preset || "sereno") as PresetName;

const {
  title = site.seo.titulo,
  description = site.seo.descripcion,
} = Astro.props;

const colores = site.diseno.colores;
const cssVars = Object.entries({
  "--color-brand-primary": colores?.primary,
  "--color-brand-light": colores?.light,
  "--color-brand-accent": colores?.accent,
  "--color-brand-surface": colores?.surface,
  "--color-brand-secondary": colores?.secondary,
})
  .filter(([, valor]) => Boolean(valor))
  .map(([nombre, valor]) => `${nombre}: ${valor}`)
  .join("; ");

const navCatalog: Record<string, { texto: string; href: string }> = {
  hero: { texto: "Inicio", href: "/#inicio" },
  nosotros: { texto: "Nosotros", href: "/#nosotros" },
  servicios: { texto: "Niveles", href: "/#niveles" },
  cachimbos: { texto: "Casos de Éxito", href: "/#cachimbos" },
};

const navLinks = site.diseno.orden
  .map((key) => navCatalog[key])
  .filter(Boolean);

const googleFontsUrl = getGoogleFontsUrl(preset, esDemo);
const schemaData = buildSchemaData(site, Astro.site);
---

<!doctype html>
<html lang="es-PE" data-preset={preset} style={cssVars || undefined} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {site.nombre}</title>
    <meta name="description" content={description} />
    {esDemo && <meta name="robots" content="noindex, nofollow" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={googleFontsUrl} rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="flex min-h-screen flex-col bg-brand-surface text-slate-800 antialiased">
    <!-- HEADER -->
    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="/" class="z-50 flex items-center gap-3">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center bg-brand-primary text-xl font-bold text-brand-accent shape-leaf-right">
            {site.siglas}
          </div>
          <div class="min-w-0">
            <span class="block truncate font-heading text-base leading-tight font-bold text-brand-primary sm:text-lg">
              {site.nombre}
            </span>
            <span class="block text-xs text-slate-500">{site.ugel}</span>
          </div>
        </a>

        <!-- NAVEGACIÓN DESKTOP -->
        <nav class="hidden items-center gap-8 text-sm font-medium text-slate-700 md:flex">
          {navLinks.map((item) => (
            <a href={item.href} class="transition hover:text-brand-primary">
              {item.texto}
            </a>
          ))}

          <a
            href="/admision"
            class="flex items-center gap-2.5 bg-brand-accent px-5 py-2.5 font-bold text-brand-primary shadow-sm transition hover:brightness-105 shape-leaf-right"
          >
            <span class="relative flex h-2.5 w-2.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-secondary opacity-75"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-brand-secondary"></span>
            </span>
            Admisión {site.anioAdmision}
          </a>
        </nav>

        <!-- BOTÓN HAMBURGUESA -->
        <button
          id="mobile-menu-btn"
          class="p-2 text-brand-primary focus:outline-none md:hidden"
          aria-label="Abrir menú"
        >
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- PANEL MENÚ MÓVIL -->
      <nav
        id="mobile-menu"
        class="absolute top-20 left-0 hidden w-full flex-col border-b border-slate-200 bg-white shadow-xl md:hidden"
      >
        {navLinks.map((item) => (
          <a
            href={item.href}
            class="mobile-link border-b border-slate-100 px-6 py-4 font-medium text-slate-700 hover:bg-slate-50 hover:text-brand-primary"
          >
            {item.texto}
          </a>
        ))}
        <div class="px-6 py-5">
          <a
            href="/school-theme/admision"
            class="flex w-full items-center justify-center gap-2.5 bg-brand-accent px-5 py-3 text-center font-bold text-brand-primary shadow-sm shape-leaf-right"
          >
            <span class="relative flex h-2.5 w-2.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-secondary opacity-75"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-brand-secondary"></span>
            </span>
            Admisión {site.anioAdmision}
          </a>
        </div>
      </nav>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="mt-20 rounded-tl-[4rem] bg-brand-primary pt-16 pb-10 text-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 md:grid-cols-3 lg:px-8">
        <div>
          <h3 class="text-xl font-bold text-brand-accent">{site.nombre}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">{site.lema}</p>
          <div class="mt-5 flex gap-4 text-sm font-semibold text-brand-accent">
            {site.contacto.redes.facebook && (
              <a href={site.contacto.redes.facebook} target="_blank" rel="noreferrer">Facebook</a>
            )}
            {site.contacto.redes.instagram && (
              <a href={site.contacto.redes.instagram} target="_blank" rel="noreferrer">Instagram</a>
            )}
            {site.contacto.redes.tiktok && (
              <a href={site.contacto.redes.tiktok} target="_blank" rel="noreferrer">TikTok</a>
            )}
          </div>
        </div>

        <div>
          <h4 class="text-sm font-bold tracking-wider text-brand-accent uppercase">
            Ubicación y Contacto
          </h4>
          <ul class="mt-3 space-y-2 text-sm text-slate-300">
            <li>📍 {site.contacto.direccion}</li>
            <li>📞 {site.contacto.telefono}</li>
            <li>✉️ {site.contacto.email}</li>
            <li>🕒 {site.contacto.horario}</li>
          </ul>
        </div>

        <div class="flex flex-col items-start justify-between md:items-end">
          <a
            href={site.contacto.libroReclamacionesUrl}
            target="_blank"
            rel="noreferrer"
            class="flex items-center gap-3 border border-white/30 bg-white/10 px-5 py-3 transition hover:bg-white/20 shape-leaf-left"
          >
            <span class="text-2xl">📖</span>
            <div class="text-left">
              <span class="block text-xs font-bold tracking-wider text-brand-accent uppercase">Indecopi</span>
              <span class="block text-sm font-semibold">Libro de Reclamaciones</span>
            </div>
          </a>
          <p class="mt-6 text-xs text-slate-400">
            © {new Date().getFullYear()} {site.nombre}. Todos los derechos reservados.
          </p>
        </div>
      </div>
    </footer>

    {/* BARRA FLOTANTE DE DEMO */}
    {esDemo && (
      <div class="fixed bottom-4 left-4 z-50 flex items-center gap-1 rounded-full border border-slate-300 bg-white/95 p-1.5 shadow-xl backdrop-blur-md">
        <span class="hidden px-2 text-xs font-semibold tracking-wider text-slate-500 uppercase sm:inline-block">Estilo:</span>
        <button data-demo-preset="sereno" class="rounded-full px-3.5 py-2 text-sm font-medium transition-colors hover:bg-slate-100">Sereno</button>
        <button data-demo-preset="editorial" class="rounded-full px-3.5 py-2 text-sm font-medium transition-colors hover:bg-slate-100">Editorial</button>
        <button data-demo-preset="cercano" class="rounded-full px-3.5 py-2 text-sm font-medium transition-colors hover:bg-slate-100">Cercano</button>
      </div>
    )}

    <script>
      const btn = document.getElementById("mobile-menu-btn");
      const menu = document.getElementById("mobile-menu");
      const menuIcon = document.getElementById("menu-icon");
      const closeIcon = document.getElementById("close-icon");
      const mobileLinks = document.querySelectorAll(".mobile-link");

      function toggleMenu() {
        menu?.classList.toggle("hidden");
        menuIcon?.classList.toggle("hidden");
        closeIcon?.classList.toggle("hidden");
      }

      btn?.addEventListener("click", toggleMenu);
      mobileLinks.forEach((link) => link.addEventListener("click", toggleMenu));
    </script>

    {esDemo && (
      <script is:inline>
        const root = document.documentElement;
        const btns = document.querySelectorAll('[data-demo-preset]');
        const urlParams = new URLSearchParams(window.location.search);
        const currentPreset = urlParams.get('estilo') || root.dataset.preset || 'sereno';

        function setPreset(preset) {
          root.dataset.preset = preset;
          btns.forEach(b => {
            if (b.dataset.demoPreset === preset) {
              b.classList.add('bg-brand-primary', 'text-brand-accent');
              b.classList.remove('text-slate-700', 'hover:bg-slate-100');
            } else {
              b.classList.remove('bg-brand-primary', 'text-brand-accent');
              b.classList.add('text-slate-700', 'hover:bg-slate-100');
            }
          });
          const newUrl = new URL(window.location);
          newUrl.searchParams.set('estilo', preset);
          window.history.replaceState({}, '', newUrl);
        }

        setPreset(currentPreset);
        btns.forEach(btn => btn.addEventListener('click', () => setPreset(btn.dataset.demoPreset)));
      </script>
    )}
  </body>
</html>